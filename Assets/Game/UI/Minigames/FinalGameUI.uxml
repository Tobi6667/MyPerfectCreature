<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/Game/UI/Minigames/uifinalUss.uss?fileID=7433441132597879392&amp;guid=a51831bde5c452544a8a8f1452b474b5&amp;type=3#uifinalUss"/>
    <ui:VisualElement name="root" class="root" style="padding-left: 20px; padding-right: 20px; padding-top: 20px; padding-bottom: 20px;">
        <ui:VisualElement name="main-panel" class="main-panel" style="padding-top: 0; border-right-color: rgb(40, 200, 20); border-left-color: rgb(40, 200, 20);">
            <ui:VisualElement name="header" class="header">
                <ui:VisualElement name="header-line-left" class="header-line"/>
                <ui:Label name="game-title" text="THE CREATURE" class="game-title"/>
                <ui:Label name="question-counter" text="QUESTION // 01" class="question-counter"/>
                <ui:VisualElement name="header-line-right" class="header-line"/>
            </ui:VisualElement>
            <ui:VisualElement name="question-panel" class="question-panel" style="padding-top: 0; justify-content: flex-end;">
                <ui:Label name="question-prefix" text="// SYSTEM QUERY" class="question-prefix" style="display: none;"/>
                <ui:Label name="question-label" text="What happens when lightning strikes the creature?" class="question-label" style="font-size: 40px;"/>
                <ui:VisualElement name="question-decoration" class="question-decoration">
                    <ui:VisualElement class="deco-line"/>
                    <ui:VisualElement class="deco-node"/>
                    <ui:VisualElement class="deco-line"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="answers-section" class="answers-section">
                <ui:Label name="answers-title" text="SELECT ANSWER" class="answers-title"/>
                <ui:VisualElement name="answers-container" class="answers-container">
                    <ui:Button name="answer-0" text="A  //  IT AWAKENS" class="answer-btn"/>
                    <ui:Button name="answer-1" text="B  //  IT DIES" class="answer-btn"/>
                    <ui:Button name="answer-2" text="C  //  NOTHING HAPPENS" class="answer-btn"/>
                    <ui:Button name="answer-3" text="D  //  IT ESCAPES" class="answer-btn"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="result-panel" class="result-panel" style="display: none;">
            <ui:VisualElement name="result-frame" class="result-frame" style="border-top-color: rgb(40, 200, 20); border-bottom-color: rgb(40, 200, 20);">
                <ui:Label name="result-prefix" text="// EXPERIMENT RESULT" class="result-prefix"/>
                <ui:Label name="result-label" text="CORRECT" class="result-label"/>
                <ui:VisualElement name="result-decoration" class="result-decoration">
                    <ui:VisualElement class="result-line"/>
                    <ui:VisualElement class="result-node"/>
                    <ui:VisualElement class="result-line"/>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="final-score-panel" class="final-score-panel" style="display: flex;">
            <ui:VisualElement name="final-score-frame" class="final-score-frame" style="background-color: rgb(40, 200, 20);">
                <ui:Label name="final-score-prefix" text="// EXPERIMENT COMPLETE" class="final-score-prefix" style="color: rgb(40, 24, 60);"/>
                <ui:Label name="final-score-title" text="FINAL SCORE" class="final-score-title" style="color: rgb(0, 0, 0);"/>
                <ui:VisualElement name="score-display" class="score-display">
                    <ui:Label name="score-value" text="8" class="score-value" style="color: rgb(26, 16, 36);"/>
                    <ui:Label name="score-divider" text="/" class="score-divider"/>
                    <ui:Label name="score-total" text="10" class="score-total" style="color: rgb(26, 16, 36);"/>
                </ui:VisualElement>
                <ui:Label name="score-description" text="EXPERIMENT SUCCESSFUL" class="score-description" style="color: rgb(26, 16, 36);"/>
                <ui:VisualElement name="score-decoration" class="score-decoration">
                    <ui:VisualElement class="score-line"/>
                    <ui:VisualElement class="score-node"/>
                    <ui:VisualElement class="score-line"/>
                </ui:VisualElement>
                <ui:Label name="score-footer" text="Thank you for playing" class="score-footer" style="font-size: 37px; color: rgb(26, 16, 36); -unity-font-style: bold;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
